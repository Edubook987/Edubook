# EduBook Mail Service Configuration

# HTTP Server Port
PORT=5000

# SMTP Server Settings (Default configured for Gmail)
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication credentials
# Leave blank to automatically use Ethereal Email test accounts with one-click preview links
SMTP_USER=
SMTP_PASS=

# Sender Details
FROM_NAME="EduBook"
FROM_EMAIL=

# Automatically use an Ethereal test account if SMTP_USER or SMTP_PASS is empty
USE_ETHEREAL_IF_NO_AUTH=true
